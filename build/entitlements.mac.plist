<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera access under the hardened runtime (getUserMedia). -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- The SmartSpectra native runtime ships ad-hoc signed dylibs. Either keep this,
         or re-sign every dylib with your identity before notarizing. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Standard for Electron/V8 under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
