# Copy to .env for development (`npm run dev` loads it; packaged builds ignore .env).
# Never commit .env.

# Presage SmartSpectra API key from https://physiology.presagetech.com/
# Alternatively paste it into the app (stored encrypted via the OS keychain).
PRESAGE_API_KEY=

# SDK telemetry (aggregate session info, never frames or metric values). Off by default.
# PRESAGE_ENABLE_TELEMETRY=false

# Cooldown tuning (seconds unless noted). Defaults shown.
# ZZ_MIN_WAIT_SEC=60
# ZZ_TOLERANCE_BPM=5
# ZZ_TOLERANCE_PCT=7
# ZZ_SUSTAIN_SEC=15
# ZZ_FALLBACK_SEC=180
# ZZ_MAX_COOLDOWN_SEC=900
# ZZ_ESCALATE_AFTER_LOSSES=5
# ZZ_CALIBRATION_SEC=60
# ZZ_LICHESS_POLL_SEC=10

# Development aids
# ZZ_LOG_LEVEL=debug
# ZZ_DEVTOOLS=1
# ZZ_USER_DATA_DIR=/tmp/zz-profile     # isolated profile (state, log, Lichess cookies)
# ZZ_SMOKE_DIR=/tmp/zz-smoke            # scripted run: captures + report.json, then quits
# SMARTSPECTRA_DIAGNOSTICS=1            # verbose SDK IPC logging
